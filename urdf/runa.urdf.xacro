<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="runa">
 <xacro:arg name="sim" default="false"/>
 <xacro:arg name="rollers" default="false"/>
 <xacro:arg name="controllers_file" default=""/>
 <xacro:if value="$(arg sim)">
  <xacro:include filename="$(find runa_description)/urdf/runa_physics.urdf"/>
  <xacro:include filename="$(find runa_sim)/urdf/simulation.xacro"/>
  <xacro:runa_simulation controllers_file="$(arg controllers_file)"/>
 </xacro:if>
 <xacro:unless value="$(arg sim)">
  <xacro:if value="$(arg rollers)"><xacro:include filename="$(find runa_description)/urdf/runa_cad_rollers.urdf"/></xacro:if>
  <xacro:unless value="$(arg rollers)"><xacro:include filename="$(find runa_description)/urdf/runa_cad.urdf"/></xacro:unless>
 </xacro:unless>
</robot>
