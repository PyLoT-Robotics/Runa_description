<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="runa_arm" params="parent">
    <joint name="lift_to_arm" type="fixed">
      <parent link="${parent}" />
      <child link="arm_link" />
    </joint>
    <material name="dark_grey">
      <color rgba="0.3 0.3 0.3 1.0" />
    </material>
    <material name="light_grey">
      <color rgba="0.7 0.7 0.7 1.0" />
    </material>
    <material name="blue">
      <color rgba="0.2 0.4 0.8 1.0" />
    </material>
    <material name="orange">
      <color rgba="0.9 0.5 0.1 1.0" />
    </material>
    <link name="arm_link">
      <visual>
        <geometry>
          <cylinder length="0.037" radius="0.04" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.0185" />
        <material name="dark_grey" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.037" radius="0.04" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.0185" />
      </collision>
      <inertial>
        <mass value="0.5" />
        <inertia ixx="0.00025704166666666665" ixy="0" ixz="0" iyy="0.00025704166666666665" iyz="0" izz="0.0004" />
      </inertial>
    </link>
    <joint name="joint1" type="revolute">
      <parent link="arm_link" />
      <child link="link1" />
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0.037" />
      <axis xyz="0 0 1" />
      <limit effort="10.0" lower="-1.2624661884298827" upper="1.9527575429784212" velocity="2.0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>
    <link name="link1">
      <visual>
        <geometry>
          <cylinder length="0.06" radius="0.03" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.03" />
        <material name="blue" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.06" radius="0.03" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.03" />
      </collision>
      <inertial>
        <mass value="0.3" />
        <inertia ixx="0.0001575" ixy="0" ixz="0" iyy="0.0001575" iyz="0" izz="0.00013499999999999997" />
      </inertial>
    </link>
    <joint name="joint2" type="revolute">
      <parent link="link1" />
      <child link="link2" />
      <origin rpy="0 0 0" xyz="0 0 0.06" />
      <axis xyz="0 -1 0" />
      <limit effort="10.0" lower="-1.3989904785517047" upper="0.8099418560036186" velocity="2.0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>
    <link name="link2">
      <visual>
        <geometry>
          <cylinder length="0.36" radius="0.025" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.18" />
        <material name="light_grey" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.36" radius="0.025" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.18" />
      </collision>
      <inertial>
        <mass value="0.25" />
        <inertia ixx="0.0027390624999999997" ixy="0" ixz="0" iyy="0.0027390624999999997" iyz="0" izz="7.812500000000002e-05" />
      </inertial>
    </link>
    <joint name="joint3" type="revolute">
      <parent link="link2" />
      <child link="link3" />
      <origin rpy="0 0 0" xyz="0 0 0.36" />
      <axis xyz="0 -1 0" />
      <limit effort="10.0" lower="-0.2239611950313036" upper="3.150796538317107" velocity="2.0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>
    <link name="link3">
      <visual>
        <geometry>
          <cylinder length="0.22" radius="0.025" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.11" />
        <material name="blue" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.22" radius="0.025" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.11" />
      </collision>
      <inertial>
        <mass value="0.2" />
        <inertia ixx="0.0008379166666666668" ixy="0" ixz="0" iyy="0.0008379166666666668" iyz="0" izz="6.250000000000001e-05" />
      </inertial>
    </link>
    <joint name="joint4" type="revolute">
      <parent link="link3" />
      <child link="link4" />
      <origin rpy="0 0 0" xyz="0 0 0.22" />
      <axis xyz="0 -1 0" />
      <limit effort="5.0" lower="-1.5370487494614125" upper="1.684310905098434" velocity="3.0" />
      <dynamics damping="0.05" friction="0.05" />
    </joint>
    <link name="link4">
      <visual>
        <geometry>
          <cylinder length="0.03" radius="0.02" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.015" />
        <material name="light_grey" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.03" radius="0.02" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.015" />
      </collision>
      <inertial>
        <mass value="0.15" />
        <inertia ixx="2.6249999999999998e-05" ixy="0" ixz="0" iyy="2.6249999999999998e-05" iyz="0" izz="3e-05" />
      </inertial>
    </link>
    <joint name="joint5" type="revolute">
      <parent link="link4" />
      <child link="link5" />
      <origin rpy="0 0 0" xyz="0 0 0.03" />
      <axis xyz="0 0 -1" />
      <limit effort="5.0" lower="-2.492718780314167" upper="3.6432043712283977" velocity="3.0" />
      <dynamics damping="0.05" friction="0.05" />
    </joint>
    <link name="link5">
      <visual>
        <geometry>
          <cylinder length="0.05" radius="0.02" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.025" />
        <material name="blue" />
      </visual>
      <collision>
        <geometry>
          <cylinder length="0.05" radius="0.02" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.025" />
      </collision>
      <inertial>
        <mass value="0.1" />
        <inertia ixx="3.0833333333333335e-05" ixy="0" ixz="0" iyy="3.0833333333333335e-05" iyz="0" izz="2e-05" />
      </inertial>
    </link>
    <joint name="gripper_base_joint" type="fixed">
      <parent link="link5" />
      <child link="gripper_base" />
      <origin rpy="0 0 0" xyz="0 0 0.060000000000000005" />
    </joint>
    <link name="gripper_base">
      <visual>
        <geometry>
          <box size="0.04 0.04 0.02" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.01" />
        <material name="dark_grey" />
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.04 0.02" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.01" />
      </collision>
      <inertial>
        <mass value="0.08" />
        <inertia ixx="1.3333333333333335e-05" ixy="0" ixz="0" iyy="1.3333333333333335e-05" iyz="0" izz="2.1333333333333338e-05" />
      </inertial>
    </link>
    <joint name="gripper_left_joint" type="prismatic">
      <parent link="gripper_base" />
      <child link="gripper_left" />
      <origin rpy="0 0 0" xyz="0 0.02 0.02" />
      <axis xyz="0 1 0" />
      <limit effort="5.0" lower="0.0" upper="0.025" velocity="0.5" />
      <dynamics damping="0.05" friction="0.1" />
    </joint>
    <link name="gripper_left">
      <visual>
        <geometry>
          <box size="0.03 0.02 0.06" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.03" />
        <material name="orange" />
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.02 0.06" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.03" />
      </collision>
      <inertial>
        <mass value="0.03" />
        <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1.1249999999999997e-05" iyz="0" izz="3.25e-06" />
      </inertial>
    </link>
    <joint name="gripper_right_joint" type="prismatic">
      <parent link="gripper_base" />
      <child link="gripper_right" />
      <origin rpy="0 0 0" xyz="0 -0.02 0.02" />
      <axis xyz="0 -1 0" />
      <limit effort="5.0" lower="0.0" upper="0.025" velocity="0.5" />
      <mimic joint="gripper_left_joint" multiplier="1.0" offset="0.0" />
      <dynamics damping="0.05" friction="0.1" />
    </joint>
    <link name="gripper_right">
      <visual>
        <geometry>
          <box size="0.03 0.02 0.06" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.03" />
        <material name="orange" />
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.02 0.06" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.03" />
      </collision>
      <inertial>
        <mass value="0.03" />
        <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1.1249999999999997e-05" iyz="0" izz="3.25e-06" />
      </inertial>
    </link>
    <joint name="tcp_joint" type="fixed">
      <parent link="gripper_base" />
      <child link="tcp" />
      <origin rpy="0 0 0" xyz="0 0 0.08" />
    </joint>
    <link name="tcp" />
  </xacro:macro>
</robot>
