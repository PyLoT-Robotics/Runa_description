<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="runa">
  <xacro:arg name="sim" default="false"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:include filename="$(find runa_description)/urdf/arm.xacro"/>
  <material name="runa_white"><color rgba="0.85 0.85 0.88 1"/></material>
  <material name="runa_dark"><color rgba="0.08 0.09 0.12 1"/></material>
  <xacro:macro name="box_body" params="name mass size xyz material">
    <link name="${name}">
      <inertial><mass value="${mass}"/><inertia ixx="${mass*0.02}" iyy="${mass*0.02}" izz="${mass*0.02}" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry><material name="${material}"/></visual>
      <collision><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry></collision>
    </link>
  </xacro:macro>
  <link name="base_footprint"/>
  <xacro:box_body name="base_link" mass="18" size="0.5 0.45 0.06" xyz="0 0 0.09" material="runa_white"/>
  <joint name="base_to_footprint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>
  <xacro:box_body name="mast_link" mass="2" size="0.1 0.2 0.76" xyz="0 0 0" material="runa_white"/>
  <joint name="base_to_mast" type="fixed"><parent link="base_link"/><child link="mast_link"/><origin xyz="-0.12 0 0.5"/></joint>
  <xacro:macro name="wheel" params="side sign">
    <link name="${side}_wheel_link">
      <inertial><mass value="0.4"/><inertia ixx="0.0003" iyy="0.0005" izz="0.0003" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.05" length="0.035"/></geometry><material name="runa_dark"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.05" length="0.035"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel_link"/><origin xyz="0 ${sign*0.195} 0.05"/><axis xyz="0 1 0"/><limit effort="20" velocity="20"/><dynamics damping="0.01"/></joint>
  </xacro:macro>
  <xacro:wheel side="left" sign="1"/><xacro:wheel side="right" sign="-1"/>
  <xacro:macro name="caster" params="name x">
    <link name="${name}"><inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><sphere radius="0.025"/></geometry><material name="runa_dark"/></visual><collision><geometry><sphere radius="0.025"/></geometry></collision></link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 0.025"/></joint>
    <gazebo reference="${name}"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="front_caster" x="0.20"/><xacro:caster name="rear_caster" x="-0.20"/>
  <xacro:box_body name="pan_link" mass="0.2" size="0.07 0.05 0.03" xyz="0 0 0" material="runa_dark"/>
  <joint name="base_to_pan_joint" type="revolute"><parent link="base_link"/><child link="pan_link"/><origin xyz="0 0 0.9"/><axis xyz="0 0 1"/><limit lower="-2.9" upper="2.9" effort="10" velocity="2"/><dynamics damping="0.2"/></joint>
  <xacro:box_body name="tilt_link" mass="0.1" size="0.04 0.04 0.03" xyz="0 0 0" material="runa_dark"/>
  <joint name="pan_to_tilt_joint" type="revolute"><parent link="pan_link"/><child link="tilt_link"/><origin xyz="0.05 0 0"/><axis xyz="0 1 0"/><limit lower="-0.2" upper="1.85" effort="5" velocity="2"/><dynamics damping="0.2"/></joint>
  <xacro:box_body name="camera_link" mass="0.1" size="0.025 0.09 0.025" xyz="0 0 0" material="runa_dark"/>
  <joint name="tilt_link_to_camera" type="fixed"><parent link="tilt_link"/><child link="camera_link"/><origin xyz="0.03 0 0"/></joint>
  <link name="d455_color_optical_frame"/><joint name="d455_optical_joint" type="fixed"><parent link="camera_link"/><child link="d455_color_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <link name="laser"/><joint name="base_to_laser" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="0.2 0 0.25"/></joint>
  <link name="livox_frame"/><joint name="base_to_livox" type="fixed"><parent link="base_link"/><child link="livox_frame"/><origin xyz="0.2 0 0.15" rpy="-0.21 -0.03 -1.57"/></joint>
  <link name="bno055_link"/><joint name="base_to_bno055" type="fixed"><parent link="base_link"/><child link="bno055_link"/></joint>
  <xacro:box_body name="lift_link" mass="0.3" size="0.08 0.08 0.03" xyz="0 0 0" material="runa_dark"/>
  <joint name="lift_joint" type="prismatic"><parent link="base_link"/><child link="lift_link"/><origin xyz="0.15 0 0.27"/><axis xyz="0 0 1"/><limit lower="0" upper="0.18" effort="1000" velocity="0.1"/><dynamics damping="1"/></joint>
  <xacro:runa_arm parent="lift_link"/>
  <link name="d415_link"/><joint name="wrist_camera_joint" type="fixed"><parent link="link5"/><child link="d415_link"/><origin xyz="0.05 0 0.035" rpy="0 ${-pi/2} ${pi}"/></joint>
  <link name="d415_color_optical_frame"/><joint name="d415_optical_joint" type="fixed"><parent link="d415_link"/><child link="d415_color_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <!-- Simulation plugins live in Runa_sim; this description loads no serial hardware. -->
  <xacro:if value="$(arg sim)">
    <xacro:include filename="$(find runa_sim)/urdf/simulation.xacro"/>
    <xacro:runa_simulation controllers_file="$(arg controllers_file)"/>
  </xacro:if>
</robot>
